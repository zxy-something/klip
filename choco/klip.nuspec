<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>klip</id>
    <version>1.0.0</version>
    <title>Klip</title>
    <authors>zxy</authors>
    <owners>zxy</owners>
    <projectUrl>https://github.com/zxy-something/klip</projectUrl>
    <packageSourceUrl>https://github.com/zxy-something/klip/tree/main/choco</packageSourceUrl>
    <projectSourceUrl>https://github.com/zxy-something/klip</projectSourceUrl>
    <docsUrl>https://github.com/zxy-something/klip#readme</docsUrl>
    <bugTrackerUrl>https://github.com/zxy-something/klip/issues</bugTrackerUrl>
    <iconUrl>https://raw.githubusercontent.com/zxy-something/klip/main/assets/icon.png</iconUrl>
    <licenseUrl>https://github.com/zxy-something/klip/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <releaseNotes>Initial release. Screen, window, camera, image and text sources; scenes; microphone and system audio; MP4 recording.</releaseNotes>
    <summary>OBS-style screen recorder for Windows.</summary>
    <description>Klip is a portable screen recorder for Windows. Compose scenes with screen, window, camera, image and text sources, mix microphone and system audio, and record to MP4 with configurable resolution, frame rate and quality.</description>
    <tags>screen-recorder recorder screen-capture video capture obs mp4 windows</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
